import kotlin.Boolean;

CREATE TABLE CategoryEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL
);

CREATE TABLE TaskEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    completed INTEGER AS Boolean NOT NULL DEFAULT 0,
    dueDateTime TEXT,
    createdAt TEXT NOT NULL,
    categoryId INTEGER,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id) ON DELETE SET NULL
);

selectAllTasks:
SELECT * FROM TaskEntity;

insertCategory:
INSERT INTO CategoryEntity(name) VALUES (?);

selectAllCategories:
SELECT * FROM CategoryEntity;    insertTask:
INSERT INTO TaskEntity(title, description, createdAt)
VALUES (?, ?, ?);